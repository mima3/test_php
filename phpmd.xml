<?xml version="1.0"?>
<ruleset name="Project Rules"
    xmlns="https://phpmd.org/xml/ruleset/1.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="https://phpmd.org/xml/ruleset/1.0.0 https://phpmd.org/xml/ruleset_xml_schema.xsd">
    <description>PHPMD rules for the Laravel TODO app.</description>

    <rule ref="rulesets/cleancode.xml">
        <exclude name="StaticAccess" />
    </rule>
    <rule ref="rulesets/codesize.xml" />
    <rule ref="rulesets/controversial.xml" />
    <rule ref="rulesets/design.xml" />
    <rule ref="rulesets/naming.xml" />
    <rule ref="rulesets/unusedcode.xml" />

    <exclude-pattern>*/tests/Feature/*</exclude-pattern>
    <exclude-pattern>*/tests/Unit/*</exclude-pattern>
</ruleset>
